# Copy this file to .env and fill in whichever provider you have access to.
# .env is gitignored. Run with --llm to enable; the pipeline falls back to
# deterministic templates when no key is set.

# Preferred: Anthropic. Used when ANTHROPIC_API_KEY is set.
# ANTHROPIC_API_KEY=sk-ant-...

# Fallback: OpenAI. Used when OPENAI_API_KEY is set and ANTHROPIC_API_KEY is not.
# OPENAI_API_KEY=sk-...
